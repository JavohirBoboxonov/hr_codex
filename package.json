{
  "name": "hr-l",
  "private": true,
  "version": "1.0.0",
  "description": "HR-L monorepo workspace",
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzimUmarov/hr-lodex.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AzimUmarov/hr-lodex/issues"
  },
  "homepage": "https://github.com/AzimUmarov/hr-lodex#readme",
  "devDependencies": {
    "@types/react": "^19.2.15",
    "concurrently": "^9.2.1"
  }
}
